# This image must already exist locally. DigitalArch never pulls database images.
PGVECTOR_IMAGE=pgvector/pgvector:pg16-bookworm
POSTGRES_DB=digitalarch
POSTGRES_USER=digitalarch
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
POSTGRES_HOST_PORT=5432
PGHOST=127.0.0.1
SESSION_HOURS=12
COOKIE_SECURE=false
# DIGITALARCH_DATA_DIR=.local
# DIGITALARCH_STORAGE_ROOT=.local/managed
# DIGITALARCH_FIXTURES=/trusted/flat/png-directory
# DIGITALARCH_NAPS2_PROFILES=C:\Tools\NAPS2\profiles.xml
OCR_WORKER_CONCURRENCY=1
OCR_LANGUAGE=ind+eng
OCR_PRIORITY=low
OCR_PROFILE=standard
OCR_PSM=3
# OCR engine/language/profile/PSM seed PostgreSQL global settings on first startup only.
# Use the administrator Settings menu after the defaults have been saved.
OCR_ENGINE=tesseract
# OCR_PADDLE_CPU_THREADS=1
# OCR_PADDLE_PYTHON=.local/paddleocr/venv/bin/python
# OCR_PADDLE_MODELS=.local/paddleocr/models
# OCR_TIMEOUT_SECONDS=120
# OCR_MAX_ATTEMPTS=3
# OCR_TESSERACT_PATH=C:\Program Files\NAPS2\lib\_win64\tesseract.exe
# OCR_TESSDATA_PATH=C:\Users\YOUR_USER\AppData\Roaming\NAPS2\components\tesseract4
